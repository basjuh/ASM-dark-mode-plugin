    <ControlTemplate x:Key="UfsDataGridColumnHeaderTemplate" TargetType="{x:Type DataGridColumnHeader}">
        <Grid SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" />
            <Border x:Name="HoverOverlay" Background="Transparent" />
            <Border BorderBrush="{DynamicResource UfsTableLineBrush}" BorderThickness="0,0,1,0" />
            <Border Height="2" Background="{DynamicResource UfsAccentBrush}" VerticalAlignment="Bottom" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <TextBlock x:Name="SortArrow"
                       Text="&#x25B2;"
                       Foreground="{DynamicResource UfsAccentBrush}"
                       FontSize="9"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Visibility="Collapsed" />
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="8" Background="Transparent" Cursor="SizeWE" />
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Background="Transparent" Cursor="SizeWE" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource UfsTableHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource UfsHoverBrush}" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                <Setter TargetName="SortArrow" Property="Text" Value="&#x25BC;" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

