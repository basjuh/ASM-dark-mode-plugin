<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="UfsThemeMarker" Color="#FF7200" />

    <SolidColorBrush x:Key="UfsBgBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="UfsBlockBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="UfsBlockAltBrush" Color="#242424" />
    <SolidColorBrush x:Key="UfsInputBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="UfsBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="UfsBorderLightBrush" Color="#444444" />
    <SolidColorBrush x:Key="UfsControlBorderBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="UfsTrackBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="UfsAccentBrush" Color="#FF7200" />
    <SolidColorBrush x:Key="UfsAccentDarkBrush" Color="#D66000" />
    <SolidColorBrush x:Key="UfsAccentPressedBrush" Color="#B34F00" />
    <SolidColorBrush x:Key="UfsTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UfsMutedBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="UfsDisabledBrush" Color="#777777" />
    <SolidColorBrush x:Key="UfsHoverBrush" Color="#33FF7200" />
    <SolidColorBrush x:Key="UfsFoundBrush" Color="#3A2A14" />
    <SolidColorBrush x:Key="UfsWhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UfsBlackBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="UfsRedBrush" Color="#FF5555" />
    <SolidColorBrush x:Key="UfsGreenBrush" Color="#6BFF8E" />
    <SolidColorBrush x:Key="UfsOrangeBrush" Color="#FF9A3C" />
    <SolidColorBrush x:Key="UfsYellowBrush" Color="#FFD166" />
    <SolidColorBrush x:Key="UfsPurpleBrush" Color="#C77DFF" />
    <SolidColorBrush x:Key="UfsTableRowBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="UfsTableRowAltBrush" Color="#242424" />
    <SolidColorBrush x:Key="UfsTableLineBrush" Color="#333333" />
    <SolidColorBrush x:Key="UfsTableSelectionBrush" Color="#3A2410" />
    <SolidColorBrush x:Key="UfsTableRowHoverBrush" Color="#2A2118" />
    <SolidColorBrush x:Key="UfsTableHighlightBrush" Color="#2E2418" />
    <SolidColorBrush x:Key="UfsTableHoverBrush" Color="#14FF7200" />
    <LinearGradientBrush x:Key="UfsTableHeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#252525" Offset="0" />
        <GradientStop Color="#1E1E1E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BeigeBorder" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BeigeLabel" Color="#2D2D2D" />
    <SolidColorBrush x:Key="DarkBorder" Color="#D66000" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#242424" />
    <SolidColorBrush x:Key="SolidBackground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="WarningMessage" Color="#FF5555" />
    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="#2D2D2D" />
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#FF7200" />
    <SolidColorBrush x:Key="UnSyncedSetting" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FoundSetting" Color="#3A2A14" />
    <SolidColorBrush x:Key="GradientBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="BeigeGradient" Color="#2D2D2D" />

    <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="#C8C8C8" />
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Background" Color="#242424" />
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Border" Color="#FF7200" />
    <SolidColorBrush x:Key="SliderThumb.Pressed.Background" Color="#2D2D2D" />
    <SolidColorBrush x:Key="SliderThumb.Pressed.Border" Color="#D66000" />
    <SolidColorBrush x:Key="SliderThumb.Disabled.Background" Color="#242424" />
    <SolidColorBrush x:Key="SliderThumb.Disabled.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SliderThumb.Static.Background" Color="#242424" />
    <SolidColorBrush x:Key="SliderThumb.Static.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SliderThumb.Track.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SliderThumb.Track.BorderBackground" Color="#242424" />
    <SolidColorBrush x:Key="SliderThumb.Grip.Fill" Color="#FF7200" />
    <SolidColorBrush x:Key="SliderThumb.Tick.Bottom" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SliderThumb.Track.Background" Color="#D66000" />

    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="#FF7200" />
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="#242424" />
    <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="#FF7200" />
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="#D66000" />
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="#D66000" />
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="#242424" />
    <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#777777" />
    <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="#FFFFFF" />

    <ControlTemplate x:Key="UfsActionButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="3"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.70" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.50" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="UfsIconButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="3"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UfsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UfsAccentDarkBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="UfsCheckBoxTemplate" TargetType="{x:Type CheckBox}">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Box"
                    Width="16"
                    Height="16"
                    Background="{DynamicResource UfsInputBrush}"
                    BorderBrush="{DynamicResource UfsControlBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="3"
                    VerticalAlignment="Center">
                <Path x:Name="Check"
                      Width="10"
                      Height="10"
                      Data="M 0,3 L 3,6 L 8,0"
                      Stretch="Uniform"
                      Stroke="{DynamicResource UfsWhiteBrush}"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource UfsAccentBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource UfsAccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource UfsAccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource UfsAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.50" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="UfsRadioButtonTemplate" TargetType="{x:Type RadioButton}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse x:Name="Outer"
                         Fill="{DynamicResource UfsInputBrush}"
                         Stroke="{DynamicResource UfsControlBorderBrush}"
                         StrokeThickness="2" />
                <Ellipse x:Name="Inner"
                         Width="8"
                         Height="8"
                         Fill="{DynamicResource UfsWhiteBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource UfsAccentBrush}" />
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource UfsAccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource UfsAccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource UfsAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.50" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="UfsSliderTemplate" TargetType="{x:Type Slider}">
        <Grid VerticalAlignment="Center" MinHeight="20">
            <Border Height="8"
                    Margin="9,0"
                    Background="{DynamicResource UfsTrackBrush}"
                    CornerRadius="4"
                    VerticalAlignment="Center" />
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Height="8"
                                        Margin="9,0,-2,0"
                                        Background="{DynamicResource UfsAccentBrush}"
                                        CornerRadius="4,0,0,4" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Width="18" Height="18">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Ellipse x:Name="ThumbEllipse"
                                         Fill="{DynamicResource UfsWhiteBrush}"
                                         Stroke="{DynamicResource UfsAccentBrush}"
                                         StrokeThickness="2" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource UfsAccentBrush}" />
                                        <Setter TargetName="ThumbEllipse" Property="Stroke" Value="{DynamicResource UfsWhiteBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource UfsAccentDarkBrush}" />
                                        <Setter TargetName="ThumbEllipse" Property="Stroke" Value="{DynamicResource UfsWhiteBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.50" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Height="8" Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="UfsButtonBase" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource UfsAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsAccentDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Ebrima" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource UfsActionButtonTemplate}" />
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UfsButtonBase}" />

    <Style x:Key="UfsIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource UfsButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template" Value="{StaticResource UfsIconButtonTemplate}" />
    </Style>

    <Style x:Key="ButtonStyle1" TargetType="{x:Type Button}" BasedOn="{StaticResource UfsIconButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ButtonStyle2" TargetType="{x:Type Button}" BasedOn="{StaticResource UfsIconButton}">
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ButtonStyle3" TargetType="{x:Type Button}" BasedOn="{StaticResource UfsIconButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ButtonStyle4" TargetType="{x:Type Button}" BasedOn="{StaticResource UfsIconButton}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ButtonStyle5" TargetType="{x:Type Button}" BasedOn="{StaticResource UfsIconButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource UfsAccentBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource UfsAccentDarkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource UfsInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource UfsAccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style TargetType="{x:Type RichTextBox}">
        <Setter Property="Background" Value="{DynamicResource UfsInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource UfsAccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource UfsInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource UfsAccentBrush}" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style x:Key="HiddenTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource UfsInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource UfsInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UfsAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UfsAccentDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource UfsWhiteBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource UfsWhiteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Ebrima" />
        <Setter Property="Template" Value="{StaticResource UfsCheckBoxTemplate}" />
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Ebrima" />
        <Setter Property="Template" Value="{StaticResource UfsRadioButtonTemplate}" />
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style x:Key="GroupBoxStyle" TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}" />

    <Style x:Key="BorderLabel" TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
    </Style>

    <Style x:Key="BorderDarkStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource UfsAccentDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
    </Style>

    <Style x:Key="BorderLightStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BorderFillLightStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
    </Style>

    <Style x:Key="GridSplitterBorderStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource UfsBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontFamily" Value="Ebrima" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UfsBlockAltBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource UfsAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource UfsAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource UfsBlockBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UfsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UfsBorderBrush}" />
        <Setter Property="FontFamily" Value="Ebrima" />
    </Style>

    <ControlTemplate x:Key="UfsListItemTemplate" TargetType="{x:Type ListBoxItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="2"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
